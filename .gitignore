# The vault syncs between machines through git (orient's scripts/vault-sync.sh).
# Kept out: per-machine state, audio, and temp files a writer renames into place.

# Obsidian's per-machine window layout.
.obsidian/workspace*.json
.trash/

# Meeting audio never syncs: it lives on the machine that keeps recordings (the VM); transcripts and summaries sync.
.knowledge/recordings/**/audio.*
.knowledge/recordings/**/transcript.log
.knowledge/recordings/**/*.tmp

# orient's per-machine state that happens to live in the vault.
.knowledge/focus/state.json
.knowledge/puzzles/plan.json
.knowledge/puzzles/pending.json
*.corrupt-*

# Writers' temp files (wp.py atomic_write, orient atomicWrite) and editor droppings.
.wp-*.tmp
.orient-*.tmp
*.tmp
.~*
.DS_Store
