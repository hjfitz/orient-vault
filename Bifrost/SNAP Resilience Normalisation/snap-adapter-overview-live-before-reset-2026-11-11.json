"alias":"cleared","formula":"c"},{"alias":"skipped","formula":"s"}],"queries":[{"data_source":"metrics","name":"c","query":"sum:snap.outbound.cleared{$env} by {type}.as_count()"},{"data_source":"metrics","name":"s","query":"sum:snap.outbound.clear_skipped{$env} by {type}.as_count()"}],"response_format":"timeseries","style":{"palette":"cool","line_type":"solid","line_width":"normal"},"display_type":"bars"}],"yaxis":{"include_zero":true,"label":"Rows","scale":"linear"}},"layout":{"x":8,"y":0,"width":4,"height":3}},{"id":8901234567890123,"definition":{"title":"Confirmations retrieved by business","title_size":"16","title_align":"left","show_legend":true,"legend_layout":"horizontal","legend_columns":["sum"],"type":"timeseries","requests":[{"formulas":[{"formula":"q"}],"queries":[{"data_source":"metrics","name":"q","query":"sum:fuse.confirmation.retrieved{service:snap-polling-service,$env,$business} by {businessid}.as_count()"}],"response_format":"timeseries","style":{"palette":"cool","line_type":"solid","line_width":"normal"},"display_type":"bars"}],"yaxis":{"include_zero":true,"label":"Confirmations","scale":"linear"}},"layout":{"x":0,"y":3,"width":12,"height":3}}]},"layout":{"x":0,"y":0,"width":12,"height":7}},{"id":2532221785033740,"definition":{"title":"Safety controls (circuit breakers, concurrency, rate limit, retry budget)","show_title":true,"type":"group","layout_type":"ordered","widgets":[{"id":8208038007277469,"definition":{"type":"note","content":"**What protects SNAP, per service.** Every limit below is per SNAP host and per Cloud Run instance.\n\n**Adapter (write):** circuit breaker (opens after 5 consecutive 5xx/network failures, re-tests after 30s) → rate limit (10 req/s, burst 20) → concurrency slots (5, 30s wait, then the create goes back to Pub/Sub as a slot timeout). At most 3 instances, so 15 concurrent SNAP requests per host. A create that fails transiently on 10 deliveries is given up on (retry exhausted) and held in replay-service.\n\n**Polling (read):** circuit breaker only (5 consecutive 5xx/network/429). No concurrency cap or rate limit, and no request timeout outside stock sync.","background_color":"gray","font_size":"14","text_align":"left","vertical_align":"top","show_tick":false,"tick_pos":"50%","tick_edge":"left","has_padding":true},"layout":{"x":0,"y":0,"width":12,"height":2}},{"id":8102732078023193,"definition":{"title":"Circuit breaker opens — adapter, by SNAP host","title_size":"16","title_align":"left","show_legend":true,"legend_layout":"horizontal","legend_columns":["sum"],"type":"timeseries","requests":[{"formulas":[{"formula":"q"}],"queries":[{"data_source":"metrics","name":"q","query":"sum:snap.circuit_opened{$env} by {snap_host}.as_count()"}],"response_format":"timeseries","style":{"palette":"warm","line_type":"solid","line_width":"normal"},"display_type":"bars"}]},"layout":{"x":0,"y":2,"width":6,"height":2}},{"id":6445884713650845,"definition":{"title":"Circuit breaker state — polling, by SNAP host (1 = open)","title_size":"16","title_align":"left","show_legend":true,"legend_layout":"horizontal","legend_columns":["max"],"type":"timeseries","requests":[{"formulas":[{"formula":"q"}],"queries":[{"data_source":"metrics","name":"q","query":"max:snap.circuit_breaker.state{$env} by {snap_host}"}],"response_format":"timeseries","style":{"palette":"warm","line_type":"solid","line_width":"normal"},"display_type":"line"}],"yaxis":{"include_zero":true,"label":"0 closed / 1 open","scale":"linear","min":"0","max":"1"},"markers":[{"label":"OPEN","value":"y = 1","display_type":"error dashed"}]},"layout":{"x":6,"y":2,"width":6,"height":2}},{"id":4694496930315996,"definition":{"title":"Requests turned away by an open breaker","title_size":"16","title_align":"left","show_legend":true,"legend_layout":"horizontal","legend_columns":["sum"],"type":"timeseries","requests":[{"formulas":[{"alias":"adapter creates (circuit_open)","formula":"a"},{"alias":"polls skipped","formula":"p"}],"queries":[{"data_source":"metrics","name":"a","query":"sum:snap.entity_not_created{$env,failure_mode:circuit_open}.as_count()"},{"data_source":"metrics","name":"p","query":"sum:snap.poll.skipped_circuit_open{$env}.as_count()"}],"response_format":"timeseries","style":{"palette":"warm","line_type":"solid","line_width":"normal"},"display_type":"bars"}]},"layout":{"x":0,"y":4,"width":6,"height":2}},{"id":6703556001272650,"definition":{"title":"Records that exhausted their redeliveries — adapter (held in replay-service)","title_size":"16","title_align":"left","show_legend":true,"legend_layout":"horizontal","legend_columns":["sum"],"type":"timeseries","requests":[{"formulas":[{"formula":"q"}],"queries":[{"data_source":"metrics","name":"q","query":"sum:snap.retry_exhausted{$env}.as_count()"}],"response_format":"timeseries","style":{"palette":"red","line_type":"solid","line_width":"normal"},"display_type":"bars"}]},"layout":{"x":6,"y":4,"width":6,"height":2}},{"id":4816143596459842,"definition":{"title":"Creates waiting for a concurrency slot — adapter, max per instance, by SNAP host","title_size":"16","title_align":"left","show_legend":true,"legend_layout":"horizontal","legend_columns":["max"],"type":"timeseries","requests":[{"formulas":[{"formula":"q"}],"queries":[{"data_source":"metrics","name":"q","query":"max:snap.slot_queue_depth{$env} by {snap_host}"}],"response_format":"timeseries","style":{"palette":"orange","line_type":"solid","line_width":"normal"},"display_type":"line"}],"markers":[{"label":"instance full (30 requests − 5 slots)","value":"y = 25","display_type":"error dashed"}]},"layout":{"x":0,"y":6,"width":6,"height":2}},{"id":3675059684089264,"definition":{"title":"Slot timeouts — adapter (sent back to Pub/Sub without reaching SNAP)","title_size":"16","title_align":"left","show_legend":true,"legend_layout":"horizontal","legend_columns":["sum"],"type":"timeseries","requests":[{"formulas":[{"formula":"q"}],"queries":[{"data_source":"metrics","name":"q","query":"sum:snap.entity_not_created{$